# =============================================================================
# NEONDROP ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your production values.
# =============================================================================

# Django Security
DJANGO_SECRET_KEY=change-this-in-production-to-a-very-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.neondrop.gg

# Database (Leave empty for SQLite in development, or provide PostgreSQL URL)
# Example: postgresql://postgres:password@localhost:5432/neondrop
DATABASE_URL=

# Redis Cache & Rate Limiting (Optional - falls back to LocMemCache if empty)
# Example: redis://127.0.0.1:6379/1
REDIS_URL=

# Telegram Administrator Integration
TELEGRAM_BOT_USERNAME=neondrop_admin

# Security / SSL (Only active when DJANGO_DEBUG=False)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
