# ==============================================================================
# NEONDROP - Production & Development Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in the values for your environment (Development or Production).
# 3. NEVER commit the real .env file or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
# Secret key: Generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=your-super-secret-django-key-here-minimum-50-characters-long

# Debug mode: Set to False in production!
DJANGO_DEBUG=False

# Allowed hosts: Comma-separated list of hostnames/domains
# Example: neondrop.gg,www.neondrop.gg,neondrop-ujly.onrender.com,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=neondrop.gg,www.neondrop.gg,neondrop-ujly.onrender.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Primary production configuration)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# Render PostgreSQL example: postgresql://neondrop_user:secret_pass@dpg-xxxx.render.com/neondrop_db
# Local SQLite fallback if left empty: sqlite:///db.sqlite3
DATABASE_URL=postgresql://neondrop_user:secret_pass@localhost:5432/neondrop_db

# ------------------------------------------------------------------------------
# 3. Redis / Caching / Rate Limiting (Optional but recommended for scale)
# ------------------------------------------------------------------------------
# Redis connection URL (Used for fast session cache, atomic locks, rate-limits)
# Format: redis://[:password]@host:port/db_number
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Domain & CSRF Security (CRITICAL for HTTPS domains)
# ------------------------------------------------------------------------------
# CSRF Trusted Origins: Comma-separated list of origins with scheme (NO trailing slashes)
# Example: https://neondrop.gg,https://www.neondrop.gg,https://neondrop-ujly.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://neondrop.gg,https://www.neondrop.gg,https://neondrop-ujly.onrender.com

# Cookie security settings (True for HTTPS production, False for local HTTP dev)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# ------------------------------------------------------------------------------
# 5. Telegram Admin & Support Integration
# ------------------------------------------------------------------------------
# Telegram bot username for deposit notifications and user support (without @)
neondrop_admin=neondrop_admin
TELEGRAM_BOT_TOKEN=your_telegram_bot_api_token_here
TELEGRAM_ADMIN_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 6. Cloud Object Storage / Media (S3 / Cloudflare R2 / Render Disk)
# ------------------------------------------------------------------------------
# If using AWS S3 / Cloudflare R2 for media files (optional, default is local /media/)
# USE_S3=False
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_STORAGE_BUCKET_NAME=neondrop-media-bucket
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto

# ------------------------------------------------------------------------------
# 7. Payment Gateways / Webhook Secrets (Optional)
# ------------------------------------------------------------------------------
# CRYPTO_API_KEY=your_crypto_processing_api_key
# PAYMENT_WEBHOOK_SECRET=your_webhook_signature_secret
